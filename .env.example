# ==========================================
# SKILL SWAP - ENVIRONMENT CONFIGURATION
# ==========================================

# Frontend API proxy target (used by the Next.js server, not the browser)
BACKEND_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder

# Backend Core & Database
ENVIRONMENT=development
DEBUG=True
DATABASE_URL=sqlite:///./skillswap.db
JWT_SECRET=super-secret-skillswap-jwt-key-2026-production

# Razorpay Payment Gateway (Test / Production)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder
PAYMENT_MODE=test

# Google Gemini AI Integration
GEMINI_API_KEY=

# Optional Cache / Worker
REDIS_URL=redis://localhost:6379/0
